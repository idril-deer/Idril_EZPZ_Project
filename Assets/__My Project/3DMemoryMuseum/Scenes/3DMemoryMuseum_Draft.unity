  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "MacBook Pro \xB7 2023\u20132026\nI bought this MacBook during the second week of my undergraduate studies.\nMy gaming laptop was too heavy to carry around, and using Figma on my iPad during tutorials was inconvenient. So, right after class one day, I went straight to the store and bought this MacBook.\nFrom that day on, it accompanied me throughout my entire undergraduate journey \u2014 through countless assignments, late nights, and creative projects.\nUnfortunately, during the first week of my master's degree, I accidentally dropped it, and it stopped working.\nAlthough it can no longer serve its original purpose, it remains a reminder of the years I spent growing, learning, and creating.\nIt no longer works, but it still holds everything it meant to me."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
