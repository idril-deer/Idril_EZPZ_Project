  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshPro
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Swing \xB7 2025\nIn 2025, I worked part-time at an immersive  theatre.\nFor one of our performances, my colleagues and I spent three or four days assembling a swing and decorating it with preserved flowers. We worked together to turn a simple swing into a beautiful stage prop.\nThis performance was especially meaningful to me because it was the first time I had been given an official character to play.\nI still remember the days we spent preparing everything together, the excitement before the performance, and the feeling of finally stepping into my role.\nThe swing was more than just a stage prop. It became a reminder of the teamwork, creativity, and excitement I experienced during that time."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
