  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "HelloKitty Plate \xB7 2026\nThis year, I started learning how to cook for the first time.\nI've always loved Hello Kitty, so when I began building my little kitchen, I couldn't resist collecting Hello Kitty cookware and kitchen utensils.\nThese little things made cooking feel more enjoyable and turned an ordinary daily routine into something I genuinely looked forward to.\nTo me, they represent more than just kitchenware. They hold the memories of learning something new and finding happiness in the little moments of everyday life.\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
